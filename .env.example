# ============================================================
# TriPersona Configuration
# ============================================================

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Neon PostgreSQL Database
DATABASE_URL=your_neon_database_url_here

# Flask Session Security
FLASK_SECRET_KEY=your_flask_secret_here

# Fernet encryption key for chat messages and titles (32 url-safe base64-encoded bytes)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Local Embeddings (FastEmbed / ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Server Network Configuration
HOST=0.0.0.0
PORT=5000

# Optional Hugging Face Token (increases download rate limits if needed)
# HF_TOKEN=your_huggingface_token_here